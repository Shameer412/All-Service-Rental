-sm font-normal text-slate-400 font-inter\">Expiry (MM/YY)</label><input type=\"text\" required=\"\" autoComplete=\"cc-exp\" placeholder=\"MM / YY\" maxLength=\"5\" class=\"form-input-primary w-full rounded-xl px-5 py-4 text-white focus:outline-none focus:ring-2 focus:ring-[#28A745]/20 focus:border-[#28A745] transition-all font-inter font-normal text-center\" name=\"expiry\" value=\"\"/></div><div class=\"space-y-2\"><label class=\"text-sm font-normal text-slate-400 font-inter\">CVV</label><input type=\"password\" required=\"\" autoComplete=\"cc-csc\" placeholder=\"***\" maxLength=\"4\" class=\"form-input-primary w-full rounded-xl px-5 py-4 text-white focus:outline-none focus:ring-2 focus:ring-[#28A745]/20 focus:border-[#28A745] transition-all font-inter font-normal text-center\" name=\"cvv\" value=\"\"/></div></div></div></div></div><div class=\"lg:col-span-5 space-y-6\"><div class=\"bg-[#0A1F30]/60 border border-[#27384980] backdrop-blur-[24px] rounded-[24px] md:rounded-[32px] p-5 md:p-8 shadow-2xl\" style=\"opacity:0;transform:translateX(20px)\"><h2 class=\"text-xl md:text-2xl font-space font-bold text-white mb-6\">Order Summary</h2><div class=\"space-y-4\"><div class=\"flex justify-between text-slate-400 font-inter font-normal\"><span>Subtotal</span><span class=\"text-white\">$380.00</span></div><div class=\"flex justify-between text-slate-400 font-inter font-normal\"><span>Protection Plan</span><span class=\"text-white\">$25.00</span></div><div class=\"flex justify-between text-slate-400 font-inter font-normal\"><span>Service Fee</span><span class=\"text-white\">$5.40</span></div><div class=\"pt-4 border-t border-[#27384980] flex justify-between items-center\"><span class=\"text-white font-space font-bold text-lg\">Total</span><span class=\"text-[#28A745] font-space font-bold text-2xl tracking-tight\">$410.40</span></div></div></div><div class=\"bg-[#0A1F30]/40 border border-[#27384940] rounded-[24px] p-6\" style=\"opacity:0;transform:translateY(10px)\"><div cl